# Copy this file to .env.local and fill in real values.
# Only variables prefixed with VITE_ are exposed to client-side code (see Vite env docs).
# Never commit .env or .env.local.

# Core vectorization API (see TODO(backend) in src/components/WorkspacePreview.tsx)
VITE_API_BASE_URL=

# Supabase Auth browser configuration. This must be a publishable/anon key,
# never SUPABASE_SERVICE_ROLE_KEY (which belongs only in backend secrets).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: where Supabase e-mail links (signup confirmation, password reset)
# return, as an exact origin, e.g. https://vectorla.app. Defaults to the
# origin the visitor is on. Must be on the Supabase redirect allowlist.
VITE_AUTH_REDIRECT_ORIGIN=

# Billing (Stripe)
VITE_STRIPE_PUBLISHABLE_KEY=

# Analytics (e.g. Plausible)
VITE_ANALYTICS_DOMAIN=

# Error tracking (e.g. Sentry)
VITE_SENTRY_DSN=
