# Copy this file to .env.local and fill in real values.
# Only variables prefixed with VITE_ are exposed to client-side code (see Vite env docs).
# Never commit .env or .env.local.

# Core vectorization API (see TODO(backend) in src/components/WorkspacePreview.tsx)
VITE_API_BASE_URL=

# Auth provider (Clerk / Auth.js / Supabase Auth / Cloudflare Access)
VITE_AUTH_PUBLISHABLE_KEY=

# Billing (Stripe)
VITE_STRIPE_PUBLISHABLE_KEY=

# Analytics (e.g. Plausible)
VITE_ANALYTICS_DOMAIN=

# Error tracking (e.g. Sentry)
VITE_SENTRY_DSN=
