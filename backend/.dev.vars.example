# Copy this file to .dev.vars for local `wrangler dev` — it simulates the
# secrets that production sets via `wrangler secret put <NAME>`.
# Never commit .dev.vars.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC key for signing conversion download URLs (StorageService.getSignedDownloadUrl).
# Any random string works locally; use a real generated secret in production.
DOWNLOAD_URL_SECRET=
